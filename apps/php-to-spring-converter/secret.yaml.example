# Template only. Copy to secret.yaml in this folder (git-ignored), fill in the values,
# then run scripts/deploy.sh php-to-spring-converter.
apiVersion: v1
kind: Secret
metadata:
  name: php-to-spring-converter-secrets
  labels:
    app: php-to-spring-converter
type: Opaque
stringData:
  APP_DEVELOPER_PASSWORD: <choose-a-strong-password>
  GEMINI_API_KEY: <your-gemini-api-key>
  GITHUB_TOKEN: <optional-github-token>
